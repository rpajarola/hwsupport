#!/bin/sh
# preremove - MVME393 Xcfb Pre-Removal Script

echo "Checking XDM status..."
if [ -f /usr/lib/X11/xdm/xdm-pid ] || /bin/ps -ef | /bin/grep '[x]dm' >/dev/null 2>&1; then
    if [ -x /usr/bin/X11/disable-xdm ]; then
        /usr/bin/X11/disable-xdm
    elif [ -f /etc/init.d/xdm ]; then
        /etc/init.d/xdm stop 2>/dev/null || true
    fi
fi

echo "Stopping any running Xcfb processes..."
killall Xcfb 2>/dev/null || true

# Remove symlink if it points to Xcfb
if [ -h /usr/bin/X11/X ]; then
    rm -f /usr/bin/X11/X
fi

exit 0
